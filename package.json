{
  "name": "habit-shaper",
  "version": "0.0.0",
  "private": true,
  "description": "A lightweight habit-building and habit-quitting web application.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "db:generate": "prisma generate --config apps/api/prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config apps/api/prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config apps/api/prisma.config.ts",
    "db:validate": "prisma validate --config apps/api/prisma.config.ts",
    "dev": "pnpm -r --parallel --if-present run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm run lint:root && pnpm -r --if-present run lint",
    "lint:root": "eslint .",
    "test": "pnpm -r --if-present run test",
    "test:db": "pnpm --filter @habit-shaper/api run test:db",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "prisma": "7.10.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
